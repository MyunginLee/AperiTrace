{
  "$defs": {
    "ArrayDescriptor": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "<i4",
            "<u4",
            "<u8",
            "<f8",
            "<c16",
            "|b1",
            "|i1",
            "|u1",
            "<U59"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "path": {
          "pattern": "^[^/\\\\:\\x00-\\x1f]+(?:/[^/\\\\:\\x00-\\x1f]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "items": {
            "maximum": 2000000,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "path",
        "dtype",
        "shape",
        "sha256"
      ],
      "title": "ArrayDescriptor",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "central_intensity": {
      "exclusiveMinimum": 0,
      "title": "Central Intensity",
      "type": "number"
    },
    "datasets": {
      "additionalProperties": {
        "$ref": "#/$defs/ArrayDescriptor"
      },
      "title": "Datasets",
      "type": "object"
    },
    "normalization": {
      "const": "I(q)/I(0)",
      "default": "I(q)/I(0)",
      "title": "Normalization",
      "type": "string"
    },
    "q_count": {
      "maximum": 2000000,
      "minimum": 0,
      "title": "Q Count",
      "type": "integer"
    },
    "sampling": {
      "const": "explicit_q_xyz_samples",
      "default": "explicit_q_xyz_samples",
      "title": "Sampling",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_ids_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selected Ids Sha256",
      "type": "string"
    },
    "sign": {
      "const": "exp(+i*q.r)",
      "default": "exp(+i*q.r)",
      "title": "Sign",
      "type": "string"
    },
    "weighting": {
      "const": "real_unit",
      "default": "real_unit",
      "title": "Weighting",
      "type": "string"
    },
    "windowing": {
      "const": "hard_scientific_crop_no_taper",
      "default": "hard_scientific_crop_no_taper",
      "title": "Windowing",
      "type": "string"
    }
  },
  "required": [
    "q_count",
    "selected_ids_sha256",
    "central_intensity",
    "datasets"
  ],
  "title": "DiffractionResult",
  "type": "object"
}
