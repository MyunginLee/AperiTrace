{
  "$defs": {
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "default": "canonical_model",
      "enum": [
        "canonical_model",
        "imported_material"
      ],
      "title": "Kind",
      "type": "string"
    },
    "license_or_access_terms": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Or Access Terms"
    },
    "name": {
      "default": "idealized canonical decagonal model set",
      "title": "Name",
      "type": "string"
    },
    "published_parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Published Parameters",
      "type": "object"
    },
    "references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    },
    "retrieval_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Date"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "source_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "units": {
      "default": "dimensionless",
      "title": "Units",
      "type": "string"
    }
  },
  "title": "MaterialProvenance",
  "type": "object"
}
