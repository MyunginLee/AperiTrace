{
  "$defs": {
    "OutputRecord": {
      "additionalProperties": false,
      "description": "An output's portable project-relative path, byte count, and exact checksum.",
      "properties": {
        "path": {
          "description": "Project-relative POSIX path; '.' and '..' segments are forbidden.",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          },
          "pattern": "^[^/\\\\:\\x00-\\x1f]+(?:/[^/\\\\:\\x00-\\x1f]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "OutputRecord",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/OutputRecord"
      },
      "title": "Files",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "files"
  ],
  "title": "FixtureManifest",
  "type": "object"
}
